# 复制为 .env 后填入自己的值；.env 不要提交到仓库
# cp .env.example .env

# ---- FOFA ----
# 官方地址用 https://fofa.info；中转站填它给的 BASE_URL
FOFA_BASE_URL=https://fofa.info
# 官方需要邮箱，中转站一般只要 key
FOFA_EMAIL=your_email@example.com
FOFA_KEY=your_fofa_key_here
# 每次最多翻几页（每页 100 条）；1 = 只取前 100 条，0 = 不限
FOFA_MAX_PAGES=1

# ---- Hunter ----
HUNTER_KEY=your_hunter_key_here

# ---- Quake ----
QUAKE_TOKEN=your_quake_token_here

# ---- Shodan ----
SHODAN_KEY=your_shodan_key_here

# ---- 可选 ----
# 运行目录（默认 <项目根>/runs/default）
# ASSET_RECON_RUN_DIR=
# 读取 .env 的目录（默认本文件所在目录，一般不用改）
# ASSET_RECON_ROOT=
# 设为 1 可关闭 TLS 证书校验（仅调试用）
# ASSET_RECON_INSECURE_TLS=
